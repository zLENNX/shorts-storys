# Kopiere diese Datei zu ".env" und trage deine Schlüssel ein.
# (start.bat macht die Kopie beim ersten Start automatisch.)

# --- Claude (Pflicht) --- https://console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
# Modell für Ideen und Skripte. Günstigere Alternative: claude-sonnet-5-5
CLAUDE_MODEL=claude-opus-5-5

# --- Stock-Videos (mind. einer empfohlen, beide kostenlos) ---
# https://www.pexels.com/api/  → "Your API Key"
PEXELS_API_KEY=
# https://pixabay.com/api/docs/ → oben "Your API key" (nach Login)
PIXABAY_API_KEY=

# --- TikTok (siehe docs/TIKTOK.md) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# --- YouTube (siehe docs/YOUTUBE.md) ---
# Die heruntergeladene OAuth-Datei als client_secret.json in den Projektordner legen.
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
# YouTube-API erlaubt ca. 6 Uploads pro Tag (Kontingent 10.000 Einheiten)
YT_MAX_UPLOADS_PER_DAY=5

# --- Veröffentlichung ---
POST_TIME=18:00
TIMEZONE=Europe/Berlin

# --- Stimme ---
DEFAULT_VOICE=de-DE-ConradNeural
DEFAULT_RATE=+8%
# Optional: Piper als Ersatzstimme (siehe README)
PIPER_EXE=
PIPER_MODEL=

# --- Aussehen ---
SUB_FONT=Arial Black
MUSIC_VOLUME=0.12
PORT=8000
